# Kee POS - Frontend Environment Configuration
# Copy this file to `.env.local` and adjust values for your local machine.
# `.env` (production / deployment) is not committed to version control.

# API endpoint for the Laravel backend.
# Production: https://pos.keetech.my.id/api
# Local dev:  http://localhost:8000/api  (via `php artisan serve`)
VITE_API_URL=http://localhost:8000/api

# Public app URL (used for meta tags, absolute links, custom domains).
# Local dev:  http://localhost:3000
VITE_APP_URL=http://localhost:3000

# Base URL used to resolve absolute asset paths.
VITE_BASE_URL=http://localhost:3000

# Display name of the application.
VITE_APP_NAME="Kee POS"

# Optional: overwrite meta/app theme colors for the tenant landing page.
# VITE_PRIMARY_COLOR=#ff6b35